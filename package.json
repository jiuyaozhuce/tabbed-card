{
  "name": "tabbed-card",
  "version": "0.1.0",
  "description": "Mushroom-styled fork of kinghat/tabbed-card: rounded button tabs instead of Material underline tabs.",
  "keywords": [
    "home-assistant",
    "homeassistant",
    "hass",
    "automation",
    "lovelace",
    "custom-cards"
  ],
  "scripts": {
    "build": "tsc && vite build",
    "build:no-check": "vite build",
    "build:mushroom": "vite build && node -e \"require('fs').copyFileSync('dist/tabbed-card.js','tabbed-card.js')\"",
    "watch": "vite build --mode development"
  },
  "dependencies": {
    "custom-card-helpers": "^1.9.0",
    "lit": "^2.6.1"
  },
  "devDependencies": {
    "@types/node": "^18.11.18",
    "typescript": "^4.9.4",
    "vite": "^4.0.4"
  }
}
